{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "react-perf", "jsx-a11y", "typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "react/jsx-no-useless-fragment": "off",
    "jsx-a11y/prefer-tag-over-role": "off",
    "unicorn/filename-case": "off"
  },
  "settings": {
    "react": { "version": "19" }
  },
  "ignorePatterns": ["dist", "docs", "dev", "node_modules"]
}
